# MapTiler account > API keys. Copy this file to .env.local and enter your key.
# EXPO_PUBLIC values are included in the app bundle; use a client map key only.
EXPO_PUBLIC_MAPTILER_API_KEY=

# Optional public HTTPS file origin. No upload keys. Current default is development R2 samples.
EXPO_PUBLIC_ROAD_BASE_URL=https://pub-5944210ae37a4e4987dea14ae0f41905.r2.dev

# Supabase Dashboard > Project Settings > API Keys > Publishable key.
# Public app key only. Never use a secret/service_role key or Google client secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after the corresponding Supabase provider and real login are verified.
# Naver uses the custom OIDC identifier custom:naver. Secrets stay in Supabase.
EXPO_PUBLIC_AUTH_KAKAO_ENABLED=false
EXPO_PUBLIC_AUTH_NAVER_ENABLED=false

# Enable only after the deletion SQL/Edge deployment and real server checks pass.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
