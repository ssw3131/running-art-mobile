{
  "name": "running-art-mobile",
  "main": "index.js",
  "version": "0.1.0",
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.4.0",
    "@noble/hashes": "2.0.1",
    "@supabase/supabase-js": "2.117.2",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:performance": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "pretypecheck": "node scripts/generate-route-types.cjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test:location": "node --test tests/location.test.mjs tests/map-config.test.mjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:courses": "node --test tests/courses.test.mjs",
    "test:gpx": "node --test tests/course-gpx.test.mjs",
    "test:running": "node --test tests/running-*.test.mjs",
    "test:route-engine": "node --test tests/route-engine-*.test.mjs",
    "test:road-files": "node --test tests/road-file-format.test.mjs tests/road-mobile-codecs.test.mjs",
    "roads:package": "node scripts/road-data/package.mjs",
    "roads:verify": "node scripts/road-data/verify.mjs",
    "roads:benchmark": "node scripts/road-data/benchmark-local.mjs",
    "roads:serve": "node scripts/road-data/serve.mjs",
    "roads:deploy": "node scripts/road-data/deploy.mjs",
    "roads:rehearse": "node scripts/road-data/rehearse.mjs",
    "roads:cache-rehearse": "node scripts/road-data/cache-rehearse.mjs",
    "test:road-cache": "node --test tests/road-cache.test.mjs",
    "test:road-deploy": "node --test tests/road-deployment.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "npx --yes expo-doctor",
    "prebuild:android": "expo prebuild --platform android --no-clean",
    "export:android": "expo export --platform android"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "private": true
}
