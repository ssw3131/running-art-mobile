{
  "expo": {
    "name": "RunPen",
    "slug": "running-art-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/runpen-launcher.png",
    "scheme": "runningart",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.runningart.mobile.dev",
      "allowBackup": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/runpen-launcher.png"
    },
    "plugins": [
      "./scripts/with-build-inputs.cjs",
      ["expo-router", { "sitemap": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F0",
          "image": "./assets/brand/runpen-launcher.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeVariant": "vulkan"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 확인하고 러닝 경로를 기록하기 위해 위치 접근이 필요합니다.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "프로필에 사용할 사진을 선택합니다.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
